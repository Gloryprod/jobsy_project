APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Front ---
FRONTEND_URL=http://localhost:3000

# --- IA (Groq, compatible OpenAI) ---
NLP_SERVICE_KEY=

# --- KkiaPay ---
KKIAPAY_PUBLIC_KEY=
KKIAPAY_PRIVATE_KEY=
KKIAPAY_SECRET_KEY=
# true en préproduction : widget et API en mode sandbox
KKIAPAY_SANDBOX=true
# Facultatif : par défaut https://api-sandbox.kkiapay.me (sandbox) ou https://api.kkiapay.me
KKIAPAY_API_URL=
# « Hash secret » du tableau de bord KkiaPay (Webhooks). Obligatoire hors local pour le webhook de virement.
KKIAPAY_WEBHOOK_SECRET=
# Endpoint de virement Mobile Money (à confirmer avec KkiaPay)
KKIAPAY_PAYOUT_URL=https://api.kkiapay.me/api/v1/payout

# --- Authentification par cookies httpOnly ---
# Front et API sur le même site (app.jobsy.bj / api.jobsy.bj) : strict. Front sur un autre domaine : none (HTTPS obligatoire).
AUTH_COOKIE_SAMESITE=strict
# true en production (HTTPS) ; vide = déduit de la requête
SESSION_SECURE_COOKIE=
# Origines autorisées à appeler l'API avec cookies (séparées par des virgules). Par défaut : FRONTEND_URL
CORS_ALLOWED_ORIGINS=

# --- Analyse des CV scannés (facultatif) : chemin du binaire pdftotext (poppler-utils) ---
PDFTOTEXT_PATH=

# En production : APP_DEBUG=false (sinon les erreurs exposent le code et la configuration)
